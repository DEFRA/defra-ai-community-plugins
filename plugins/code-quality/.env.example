# Optional. Copy to `.env` at the workspace root where the agent runs.
# Controls the Sonar licence capacities used by the cost-intelligence step
# in scripts/process_sonar_metrics.py --stage cost. Defaults apply if unset.

LOC_UTILISATION_HIGH_PCT=90
LOC_UTILISATION_MEDIUM_PCT=75

# SonarCloud — Defra organisation
SONARCLOUD_DEFRA_PLAN=Enterprise Edition
SONARCLOUD_DEFRA_LOC_CAPACITY=1000000
SONARCLOUD_DEFRA_BILLING_FREQUENCY=annual
SONARCLOUD_DEFRA_BILLING_BASIS=private

# SonarCloud — DefraGovUK organisation
SONARCLOUD_DEFRAGOVUK_PLAN=Team plan
SONARCLOUD_DEFRAGOVUK_LOC_CAPACITY=300000
SONARCLOUD_DEFRAGOVUK_BILLING_FREQUENCY=annual
SONARCLOUD_DEFRAGOVUK_BILLING_BASIS=private

# SonarQube (self-hosted)
SONARQUBE_PLAN=Enterprise Edition
SONARQUBE_LOC_CAPACITY=5000000
SONARQUBE_EXPIRATION=
